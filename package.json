{
  "name": "unite4ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @unite4ai/web dev",
    "build": "bun run --filter @unite4ai/web build",
    "preview": "bun run --filter @unite4ai/web preview",
    "check": "bun run --filter @unite4ai/web check",
    "validate": "bun run --filter @unite4ai/web validate",
    "verify-artifacts": "bun run --filter @unite4ai/web verify-artifacts",
    "new:model": "bun run --filter @unite4ai/web new:model",
    "publish:cli": "bun run --filter @unite4ai/cli publish",
    "test": "bun test apps/web/test apps/api/test packages/core/test scripts/agent",
    "sync:d1": "bun run --filter @unite4ai/api sync:d1",
    "agent:setup": "bash scripts/agent/setup.sh",
    "agent:verify": "node scripts/agent/verify.mjs",
    "agent:model": "node scripts/agent/model-check.mjs",
    "agent:request": "node scripts/agent/request.mjs"
  }
}
