---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = 'Unite4AI — equitable, genuinely open AI. An open model & dataset registry, a free open-source technology school, and a global community.' } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';

const nav = [
  { label: 'Stack', href: '/stack' },
  { label: 'Registry', href: '/registry' },
  { label: 'School', href: '/school' },
  { label: 'Places', href: '/places' },
  { label: 'Community', href: '/community' },
  { label: 'Search', href: '/search' },
  { label: 'Contribute', href: '/contribute' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Unite4AI</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={`${title} · Unite4AI`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- GitHub Pages cannot set HTTP headers, so CSP ships as a meta tag. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://giscus.app; worker-src 'self' blob:; frame-src https://giscus.app; connect-src 'self' https://api.github.com https://tiles.openfreemap.org https://*.basemaps.cartocdn.com https://power.larc.nasa.gov https://api.open-meteo.com https://developer.nrel.gov https://nominatim.openstreetmap.org; base-uri 'self'; form-action 'self'" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="bar">
        <a class="brand" href={href('/')}>Unite<span>4AI</span></a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => (
            <a href={href(n.href)} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <strong>Unite4AI</strong>
            <p style="max-width:30ch">Equitable AI as a global public resource. Progress is not automatic.</p>
          </div>
          <div>
            <strong>Build</strong>
            <a href={href('/registry')}>Model registry</a>
            <a href={href('/registry/datasets')}>Dataset registry</a>
            <a href={href('/contribute')}>Contribute</a>
          </div>
          <div>
            <strong>Learn</strong>
            <a href={href('/school')}>Open school</a>
            <a href={href('/community')}>Events</a>
            <a href={href('/search')}>Search</a>
          </div>
          <div>
            <strong>Open</strong>
            <a href="https://github.com/unite4ai/unite4ai.github.io">Source on GitHub</a>
            <a href={href('/governance')}>Governance</a>
            <a href={href('/governance/metrics')}>Metrics</a>
            <a href={href('/privacy')}>Privacy</a>
          </div>
        </div>
        <p style="margin-top:2rem;font-size:.8rem">
          Content CC BY 4.0 · Code Apache-2.0 · This entire site is open source — fork it.
        </p>
      </div>
    </footer>
    <script>
      import { initWebVitals } from '../lib/web-vitals.mjs';
      initWebVitals();
    </script>
  </body>
</html>
