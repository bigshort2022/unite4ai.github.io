---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((p) => ({ params: { id: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
---
<Base title={d.title} description={d.summary}>
  <article class="wrap section" data-pagefind-body>
    <p class="eyebrow"><a href={href('/community')}>Blog</a></p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <div class="card-meta" style="margin:1.2rem 0 2.5rem">
      <span class="tag">{d.author}</span>
      <span class="tag">{d.published.toISOString().slice(0, 10)}</span>
      {d.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="prose"><Content /></div>
  </article>
</Base>
