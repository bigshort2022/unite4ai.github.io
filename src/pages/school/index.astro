---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const courses = await getCollection('courses');

const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
const PERSONA_LABEL: Record<string, string> = {
  'ai-learner': 'AI Learner / Mentor',
  'model-app-contributor': 'Model / App Contributor',
  'dataset-code-contributor': 'Dataset / Code Contributor',
  'model-app-user': 'Model / App User',
};

const stackTrack = courses
  .filter((c) => c.data.track === 'open-stack')
  .sort((a, b) => (a.data.track_order ?? 99) - (b.data.track_order ?? 99));
const generalCourses = courses.filter((c) => c.data.track !== 'open-stack');
---
<Base title="The open school">
  <section class="wrap section">
    <p class="eyebrow">Open technology school</p>
    <h1>Learn AI. <span class="grad-text">Free, forever.</span></h1>
    <p class="lede">
      No account, no paywall, no tracking. Courses are written for the four people this community
      is built for — learners, contributors, dataset stewards, and applied users.
    </p>

    {stackTrack.length > 0 && (
      <div style="margin-top:2.5rem" aria-labelledby="open-stack-track">
        <h2 id="open-stack-track">Use the open stack</h2>
        <p class="lede" style="font-size:.95rem">Four modules — data, weights, compute, verify. <a href={href('/stack')}>Stack map →</a></p>
        <ol class="stack-course-track" style="margin-top:1.2rem">
          {stackTrack.map((c) => (
            <li class="card">
              <span class="tag">{c.data.duration_minutes} min · {c.data.level}</span>
              <h3><a href={href(`/school/${c.id}`)}>{c.data.title}</a></h3>
              <p>{c.data.summary}</p>
            </li>
          ))}
        </ol>
      </div>
    )}

    {generalCourses.length === 0 && stackTrack.length === 0 ? (
      <div class="empty" style="margin-top:2rem">No courses published yet.</div>
    ) : generalCourses.length > 0 && (
      LEVELS.map((level) => {
        const group = generalCourses.filter((c) => c.data.level === level);
        return group.length > 0 ? (
          <div style="margin-top:2.5rem">
            <h2 style="text-transform:capitalize">{level}</h2>
            <div class="grid grid-3" style="margin-top:1.2rem">
              {group.map((c) => (
                <article class="card">
                  <h3><a href={href(`/school/${c.id}`)}>{c.data.title}</a></h3>
                  <p>{c.data.summary}</p>
                  <div class="card-meta">
                    <span class="tag">{c.data.duration_minutes} min</span>
                    {c.data.persona.map((p) => <span class="tag">{PERSONA_LABEL[p]}</span>)}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ) : null;
      })
    )}
  </section>
</Base>

<style>
  .stack-course-track { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .stack-course-track li { padding: 1rem 1.2rem; }
  .stack-course-track h3 { margin: .4rem 0; }
</style>
