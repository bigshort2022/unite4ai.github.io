---
import Base from '../../../layouts/Base.astro';
import OpennessMeter from '../../../components/OpennessMeter.astro';
import { getCollection, render } from 'astro:content';
import { opennessScore } from '../../../lib/openness-score.mjs';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((m) => ({ params: { id: m.id }, props: { entry: m } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const score = opennessScore(d.openness);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
---
<Base title={d.name} description={d.summary}>
  <article class="wrap section" data-pagefind-body data-pagefind-meta={`openness:${score}`} data-pagefind-filter={`license:${d.license}`}>
    <p class="eyebrow"><a href={href('/registry')}>Registry</a> · Model</p>
    <h1>{d.name}</h1>
    <p class="lede">{d.summary}</p>

    <div class="card-meta" style="margin:1.2rem 0 2rem">
      <span class="tag tag-open">{d.license}</span>
      {d.tasks.map((t) => <span class="tag">{t}</span>)}
      {d.domains.map((x) => <span class="tag">{x}</span>)}
      {d.sdg_alignment.map((s) => <span class="tag">SDG {s}</span>)}
      {d.community_led && <span class="tag tag-open">community-led</span>}
    </div>

    <div class="grid grid-2" style="margin-bottom:2.5rem">
      <div class="card">
        <OpennessMeter openness={d.openness} />
      </div>
      <div class="card">
        <p class="eyebrow" style="margin-bottom:.6rem">Artifacts &amp; verification</p>
        {d.artifacts.length === 0 ? (
          <p>No artifacts registered yet.</p>
        ) : (
          <ul style="margin:0;padding-left:1.1rem;font-size:.9rem">
            {d.artifacts.map((a) => (
              <li style="margin-bottom:.6rem">
                <a href={a.url}>{a.kind}</a>
                {a.sha256 && <><br /><code style="font-size:.72rem;word-break:break-all">sha256:{a.sha256.slice(0, 32)}…</code></>}
              </li>
            ))}
          </ul>
        )}
        <p style="font-size:.82rem;color:var(--u-text-faint);margin:.8rem 0 0">
          Verify any download: <code>sha256sum &lt;file&gt;</code> and compare.
        </p>
      </div>
    </div>

    <div class="prose"><Content /></div>

    <p style="margin-top:3rem;font-size:.88rem;color:var(--u-text-faint)">
      Maintained by {d.maintainers.join(', ')} · Updated {d.updated.toISOString().slice(0, 10)} ·
      <a href={`https://github.com/unite4ai/unite4ai.github.io/edit/main/src/content/models/${entry.id}.md`}>Suggest an edit</a>
    </p>
  </article>
</Base>
