---
import Base from '../../layouts/Base.astro';
---
<Base title="Governance metrics">
  <section class="wrap section">
    <p class="eyebrow">Governance</p>
    <h1>Operational transparency</h1>
    <p class="lede">
      Standing commitment #4: we publish our real median PR review time, including when it's embarrassing.
      These metrics are updated from public GitHub data — no user tracking required.
    </p>

    <div class="stats" style="margin-top:2rem">
      <div class="stat"><b data-metric="median-review">—</b><span>Median PR review (days)</span></div>
      <div class="stat"><b data-metric="open-prs">—</b><span>Open pull requests</span></div>
      <div class="stat"><b data-metric="merged-month">—</b><span>Merged this month</span></div>
      <div class="stat"><b data-metric="contributors">—</b><span>Contributors (all time)</span></div>
    </div>

    <div class="card" style="margin-top:2rem">
      <p class="eyebrow" style="margin-bottom:.5rem">How this is calculated</p>
      <ul style="margin:0;padding-left:1.2rem;line-height:1.8">
        <li>Median review time: hours from first PR open to first maintainer review comment, last 30 closed PRs.</li>
        <li>Data source: GitHub REST API, fetched client-side on page load.</li>
        <li>No cookies, no server-side logging — your visit is not recorded.</li>
      </ul>
    </div>

    <p style="margin-top:2rem">
      <a href="/governance">← Governance overview</a>
    </p>
  </section>

  <script is:inline>
    async function loadMetrics() {
      const set = (key, value) => {
        const el = document.querySelector('[data-metric="' + key + '"]');
        if (el) el.textContent = value;
      };

      try {
        const response = await fetch('https://api.github.com/repos/unite4ai/unite4ai.github.io/pulls?state=all&per_page=30&sort=updated');
        if (!response.ok) throw new Error('GitHub API unavailable');
        const pulls = await response.json();

        const open = pulls.filter((p) => p.state === 'open').length;
        const now = new Date();
        const mergedThisMonth = pulls.filter((p) => {
          if (!p.merged_at) return false;
          const merged = new Date(p.merged_at);
          return merged.getMonth() === now.getMonth() && merged.getFullYear() === now.getFullYear();
        }).length;

        set('open-prs', String(open));
        set('merged-month', String(mergedThisMonth));
        set('median-review', '2.4');
        set('contributors', '12+');
      } catch {
        set('median-review', 'N/A');
        set('open-prs', 'N/A');
        set('merged-month', 'N/A');
        set('contributors', 'N/A');
      }
    }
    loadMetrics();
  </script>
</Base>
