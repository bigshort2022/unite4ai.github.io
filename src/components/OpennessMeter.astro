---
interface Props {
  openness: { weights: string; training_data: string; training_code: string; evaluation: string };
}
const { openness } = Astro.props;

// Model Openness Framework axes → a score anyone can read at a glance.
const SCORE: Record<string, number> = { open: 100, documented: 70, partial: 40, closed: 0 };
const LABEL: Record<string, string> = {
  weights: 'Weights', training_data: 'Training data', training_code: 'Training code', evaluation: 'Evaluation',
};
const rows = Object.entries(openness) as [string, string][];
const overall = Math.round(rows.reduce((s, [, v]) => s + (SCORE[v] ?? 0), 0) / rows.length);
---
<div>
  <p class="eyebrow" style="margin-bottom:.15rem">Openness · {overall}%</p>
  <p style="margin:0 0 .9rem;font-size:.78rem;color:var(--u-text-faint)">Scored on the Model Openness Framework</p>
  <dl class="openness">
    {rows.map(([k, v]) => (
      <div>
        <dt>{LABEL[k]}</dt>
        <dd class="meter" style="margin:0"><i style={`width:${SCORE[v] ?? 0}%`}></i></dd>
        <dd style="margin:0"><span class={`tag ${v === 'open' ? 'tag-open' : v === 'closed' ? 'tag-closed' : 'tag-partial'}`}>{v}</span></dd>
      </div>
    ))}
  </dl>
</div>
