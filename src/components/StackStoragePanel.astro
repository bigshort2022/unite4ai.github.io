---
/**
 * Dataset storage provenance for the open stack data layer.
 */
import { STORAGE_PROTOCOLS } from '../lib/stack-layers.mjs';

interface Storage {
  protocol?: keyof typeof STORAGE_PROTOCOLS;
  content_address?: string;
  mirror_urls?: string[];
}

interface Props {
  storage?: Storage;
}

const { storage } = Astro.props;
const hasStorage = Boolean(storage && (storage.protocol || storage.content_address || (storage.mirror_urls?.length ?? 0) > 0));
---
{hasStorage && storage && (
  <section class="card" style="margin-bottom:2rem" aria-label="Storage provenance">
    <p class="eyebrow" style="margin-bottom:.6rem">Open stack · Data storage</p>
    <dl style="display:grid;gap:.8rem;margin:0;font-size:.92rem">
      {storage.protocol && (
        <div><dt style="color:var(--u-text-faint);font-size:.8rem">Protocol</dt><dd style="margin:.2rem 0 0">{STORAGE_PROTOCOLS[storage.protocol] ?? storage.protocol}</dd></div>
      )}
      {storage.content_address && (
        <div><dt style="color:var(--u-text-faint);font-size:.8rem">Content address</dt><dd style="margin:.2rem 0 0"><code style="font-size:.82rem">{storage.content_address}</code></dd></div>
      )}
      {(storage.mirror_urls?.length ?? 0) > 0 && (
        <div>
          <dt style="color:var(--u-text-faint);font-size:.8rem">Mirrors</dt>
          <dd style="margin:.2rem 0 0">
            <ul style="margin:0;padding-left:1.1rem">
              {storage.mirror_urls!.map((url) => <li><a href={url}>{url}</a></li>)}
            </ul>
          </dd>
        </div>
      )}
    </dl>
  </section>
)}
