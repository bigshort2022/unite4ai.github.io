<div class="open-wordmark">
  <p class="open-wordmark-text">
    <span class="sr-only">Open source, open science, open models, open data.</span>
    <span aria-hidden="true">OPEN <span class="open-wordmark-words">
      <span data-open-word>SOURCE</span>
      <span data-open-word hidden>SCIENCE</span>
      <span data-open-word hidden>MODELS</span>
      <span data-open-word hidden>DATA</span>
    </span></span>
  </p>
  <button class="open-wordmark-toggle" type="button" disabled aria-label="Pause word rotation">Pause</button>
</div>

<style>
  .open-wordmark { margin-block: 1.25rem; }
  .open-wordmark-text {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .03em;
    white-space: nowrap;
  }
  /* All words occupy the same grid cell, reserving the widest suffix. */
  .open-wordmark-words { display: inline-grid; text-align: left; }
  [data-open-word] { grid-area: 1 / 1; }
  [data-open-word][hidden] { display: block; visibility: hidden; }
  .open-wordmark-toggle {
    visibility: hidden;
    margin-top: .5rem;
    padding: .25rem .5rem;
    font: inherit;
    font-size: .8rem;
    color: var(--u-text-dim);
    background: transparent;
    border: 1px solid var(--u-border);
    border-radius: var(--u-radius-sm);
    cursor: pointer;
  }
  .open-wordmark-toggle:enabled { visibility: visible; }
  @media (prefers-reduced-motion: reduce) {
    .open-wordmark-toggle { visibility: hidden !important; }
  }
</style>

<script>
  const words = Array.from(document.querySelectorAll<HTMLElement>('[data-open-word]'));
  const toggle = document.querySelector<HTMLButtonElement>('.open-wordmark-toggle');
  if (words.length && toggle) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let paused = false;
    let timer: ReturnType<typeof setInterval> | undefined;
    let fade: Animation | undefined;

    const update = () => {
      clearInterval(timer);
      fade?.cancel();
      toggle.disabled = reducedMotion.matches;
      toggle.textContent = paused ? 'Resume' : 'Pause';
      toggle.setAttribute('aria-label', `${paused ? 'Resume' : 'Pause'} word rotation`);
      if (reducedMotion.matches) {
        index = 0;
        words.forEach((word, position) => { word.hidden = position !== 0; });
      } else if (!paused) {
        timer = setInterval(() => {
          words[index].hidden = true;
          index = (index + 1) % words.length;
          words[index].hidden = false;
          fade = words[index].animate([{ opacity: .65 }, { opacity: 1 }], { duration: 240 });
        }, 3200);
      }
    };

    toggle.addEventListener('click', () => { paused = !paused; update(); });
    reducedMotion.addEventListener('change', update);
    update();
  }
</script>
