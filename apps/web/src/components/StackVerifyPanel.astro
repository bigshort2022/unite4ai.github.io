---
/**
 * Stack verification panel — weights, eval, inference layers.
 */
import { INFERENCE_PROTOCOLS } from '@unite4ai/core';
import type { Artifact, EvalBundle } from '@unite4ai/schema';

interface Inference {
  protocol?: keyof typeof INFERENCE_PROTOCOLS;
  endpoint_url?: string;
  content_address?: string;
  run_local_guide?: string;
}

interface Props {
  artifacts?: Artifact[];
  inference?: Inference;
  evalBundle?: EvalBundle;
}

const { artifacts = [], inference, evalBundle } = Astro.props;
const hasWeights = artifacts.some((artifact) => artifact.kind === 'weights');
const hasChecksum = artifacts.some((artifact) => artifact.sha256) || Boolean(evalBundle);
const hasInference = Boolean(inference?.endpoint_url || inference?.run_local_guide || inference?.content_address);
const localGuide = inference?.run_local_guide;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const guideHref = localGuide?.startsWith('/') ? href(localGuide) : localGuide;
const guideLabel = localGuide === '/school/run-open-weights' ? 'General course — not model-specific' : 'Setup guide';
---

<section class="stack-verify card" aria-label="Artifacts and evidence">
  <p class="eyebrow" style="margin-bottom:.6rem">Artifacts and evidence</p>
  <div class="stack-verify-tabs">
    <details open={artifacts.length > 0}>
      <summary>Listed artifacts</summary>
      {!hasWeights && <p>No weights listed.</p>}
      {artifacts.length > 0 && (
        <ul class="stack-verify-list">
          {artifacts.map((a) => (
            <li>
              <a href={a.url}>{a.kind === 'paper' ? 'Paper' : a.kind}</a>
              {a.sha256 ? (
                <div class="verify-block" data-verify-artifact data-url={a.url} data-expected={a.sha256}>
                  <code class="verify-hash">sha256:{a.sha256}</code>
                  <button type="button" class="btn btn-ghost verify-run" data-verify-btn>Check file checksum</button>
                  <p class="verify-status" data-verify-status hidden aria-live="polite"></p>
                </div>
              ) : (
                <p class="verify-hint">No SHA-256 checksum listed for this link.</p>
              )}
            </li>
          ))}
        </ul>
      )}
    </details>

    <details open={Boolean(evalBundle)}>
      <summary>Evaluation bundle</summary>
      {evalBundle ? (
        <div class="verify-block" data-verify-artifact data-url={evalBundle.url} data-expected={evalBundle.sha256}>
          <p><a href={evalBundle.url}>Download eval bundle</a></p>
          <code class="verify-hash">sha256:{evalBundle.sha256}</code>
          <button type="button" class="btn btn-ghost verify-run" data-verify-btn>Check bundle checksum</button>
          <p class="verify-status" data-verify-status hidden aria-live="polite"></p>
          {evalBundle.reproducible && (
            <p class="verify-hint">Listed as replayable. This is not a record of a successful replay.</p>
          )}
        </div>
      ) : (
        <p>No evaluation bundle listed. Reported runs, if available, are listed under Evaluations.</p>
      )}
    </details>

    <details open={hasInference}>
      <summary>Inference</summary>
      {hasInference ? (
        <dl class="stack-verify-dl">
          {inference?.protocol && (
            <div><dt>Protocol</dt><dd>{INFERENCE_PROTOCOLS[inference.protocol] ?? inference.protocol}</dd></div>
          )}
          {inference?.endpoint_url && (
            <div><dt>Endpoint</dt><dd><a href={inference.endpoint_url}>{inference.endpoint_url}</a></dd></div>
          )}
          {inference?.content_address && (
            <div><dt>Content address</dt><dd><code>{inference.content_address}</code></dd></div>
          )}
          {guideHref && (
            <div><dt>Local-running guidance</dt><dd><a href={guideHref}>{guideLabel}</a></dd></div>
          )}
        </dl>
      ) : (
        <p>No inference endpoint or setup guide listed.</p>
      )}
    </details>
  </div>

  {hasChecksum ? (
    <p class="verify-footer">A matching SHA-256 checks the downloaded bytes, not the license, provenance, or result. If the browser blocks the check, download the file and compare its SHA-256 locally.</p>
  ) : (
    <p class="verify-footer">No artifact checksum listed on this card.</p>
  )}
</section>

<style>
  .stack-verify-tabs details { margin-bottom: .75rem; border-top: 1px solid var(--u-line); padding-top: .75rem; }
  .stack-verify-tabs summary { cursor: pointer; font-weight: 600; }
  .stack-verify-list { margin: .5rem 0 0; padding-left: 1.1rem; font-size: .9rem; }
  .verify-block { margin-top: .5rem; }
  .verify-hash { display: block; font-size: .72rem; word-break: break-all; margin: .3rem 0; }
  .verify-hint { font-size: .82rem; color: var(--u-text-faint); margin: .3rem 0 0; }
  .verify-footer { margin-top: 1rem; font-size: .85rem; border-top: 1px solid var(--u-line); padding-top: .75rem; }
  .stack-verify-dl { display: grid; gap: .6rem; margin: .5rem 0 0; font-size: .9rem; }
  .stack-verify-dl dt { color: var(--u-text-faint); font-size: .78rem; }
  .verify-run { margin-top: .4rem; font-size: .82rem; padding: .35rem .7rem; }
  .verify-status { font-size: .82rem; margin: .4rem 0 0; }
  .verify-status[data-state="ok"] { color: var(--u-accent); }
  .verify-status[data-state="fail"] { color: var(--u-verify-fail, #c66); }
  .verify-status[data-state="busy"] { color: var(--u-text-faint); }
</style>

<script>
  import { sha256FromUrl, formatBytes } from '../lib/artifact-verify.ts';

  document.querySelectorAll('[data-verify-artifact]').forEach((block) => {
    const btn = block.querySelector('[data-verify-btn]') as HTMLButtonElement | null;
    const status = block.querySelector('[data-verify-status]') as HTMLElement | null;
    const url = block.getAttribute('data-url');
    const expected = block.getAttribute('data-expected');
    if (!btn || !status || !url || !expected) return;

    btn.addEventListener('click', async () => {
      status.hidden = false;
      status.dataset.state = 'busy';
      status.textContent = 'Downloading and hashing…';
      btn.disabled = true;
      try {
        const hash = await sha256FromUrl(url, (loaded, total) => {
          status.textContent = total
            ? `Hashing… ${formatBytes(loaded)} / ${formatBytes(total)}`
            : `Hashing… ${formatBytes(loaded)} downloaded`;
        });
        if (hash === expected) {
          status.dataset.state = 'ok';
          status.textContent = 'The downloaded bytes match the listed checksum.';
        } else {
          status.dataset.state = 'fail';
          status.textContent = `Mismatch. Got ${hash.slice(0, 16)}… expected ${expected.slice(0, 16)}…`;
        }
      } catch (err) {
        status.dataset.state = 'fail';
        status.textContent = err instanceof Error ? `Checksum check failed: ${err.message}` : 'Checksum check failed.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
