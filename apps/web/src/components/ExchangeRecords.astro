---
import type { ExchangeFeeds } from '@unite4ai/core/exchange';
import { getCollection } from 'astro:content';
interface Props { exchange: ExchangeFeeds; hypotheses?: ExchangeFeeds['structure']['hypotheses']; findings?: ExchangeFeeds['structure']['findings'] }
const { exchange, hypotheses = [], findings = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const results = findings.length ? new Map((await getCollection('evals')).map((result) => [result.id, result.data])) : new Map();
---
<ul class="exchange-records">
  {hypotheses.map((record) => <li class="exchange-hypothesis">
    <a href={href(`/exchange/hypotheses/${record.id}`)}>{exchange.text.hypotheses[record.id].title}</a>
    <span class="tag">{record.status}</span>
    <p>{record.findings.length} findings · {record.unreviewed_findings.length} unreviewed · GitHub account: {record.author}</p>
  </li>)}
  {findings.map((record) => <li>
    <a href={href(`/exchange/findings/${record.id}`)}>{record.id}</a>
    <span class="tag">{record.state}</span> <span class="tag">{record.verdict}</span>
    {record.superseded_by.length > 0 && <strong class="tag tag-partial">superseded</strong>}
    <p class="exchange-summary">{exchange.text.findings[record.id].summary}</p>
    <p>{record.reviews.length} reviews · {record.graft_count} grafts · GitHub account: {record.author}</p>
    <details class="exchange-reading-notes">
      <summary>Provenance and reading notes</summary>
      <p>Recorded {record.date}. Reported verdict: {record.verdict}. Account attribution is not proof of independent people or reproduction.</p>
      {exchange.text.findings[record.id].agent && <p>Self-reported model: {exchange.text.findings[record.id].agent?.model} · Harness: {exchange.text.findings[record.id].agent?.harness}</p>}
      <p>{exchange.text.findings[record.id].limitations}</p>
      <ul>{record.results.map((id) => <li><a href={href(`/evals/${results.get(id)?.benchmark}#run-${id}`)}>{id}</a></li>)}</ul>
      <p><a href={href(`/exchange/findings/${record.id}`)}>Full record, evidence and reviews</a></p>
    </details>
  </li>)}
</ul>
