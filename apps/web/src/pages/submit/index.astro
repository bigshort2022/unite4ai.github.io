---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const REPO = 'https://github.com/unite4ai/unite4ai.github.io';
---
<Base title="Submit a model">
  <section class="wrap section">
    <p class="eyebrow">Contribute</p>
    <h1>Submit to the registry</h1>
    <p class="lede">
      No account required. Fill this form and we'll open a GitHub issue with your submission —
      a maintainer turns it into a pull request. Git users can still <a href={href('/contribute')}>PR directly</a>.
    </p>

    <form class="card submit-form" style="margin-top:2rem" id="submit-form">
      <label>
        Submission type
        <select name="type" required>
          <option value="model">Open model</option>
          <option value="dataset">Open dataset</option>
          <option value="compute">Compute option</option>
        </select>
      </label>
      <label>
        Name
        <input name="name" type="text" required maxlength="120" placeholder="My Open Model" />
      </label>
      <label>
        Summary (max 300 chars)
        <textarea name="summary" required maxlength="300" rows="3" placeholder="One-line description"></textarea>
      </label>
      <label>
        License (SPDX)
        <input name="license" type="text" required placeholder="apache-2.0" />
      </label>
      <label>
        Maintainer GitHub handle(s)
        <input name="maintainers" type="text" required placeholder="your-handle" />
      </label>
      <label>
        Artifact URL (weights, dataset, or repo)
        <input name="artifact_url" type="url" placeholder="https://..." />
      </label>
      <label>
        SHA-256 checksum (optional, 64 hex chars)
        <input name="sha256" type="text" pattern="[a-f0-9]{64}" placeholder="64-character hex digest" />
      </label>
      <label>
        Domains (comma-separated)
        <input name="domains" type="text" placeholder="healthcare, climate" />
      </label>
      <label>
        Additional notes
        <textarea name="notes" rows="4" placeholder="Openness details, eval bundle links, inference setup…"></textarea>
      </label>
      <button type="submit" class="btn btn-primary">Open GitHub submission issue</button>
    </form>

    <p style="margin-top:1.5rem;font-size:.88rem;color:var(--u-text-faint)">
      Or run locally: <code>bun run publish:cli -- validate</code> then <code>bun run publish:cli -- new-model my-slug</code>
    </p>
  </section>

  <style>
    .submit-form { display: grid; gap: 1rem; max-width: 36rem; }
    .submit-form label { display: grid; gap: .35rem; font-size: .88rem; font-weight: 500; }
    .submit-form input, .submit-form select, .submit-form textarea {
      font: inherit; padding: .55rem .65rem; border: 1px solid var(--u-line);
      border-radius: 4px; background: var(--u-bg);
    }
  </style>

  <script is:inline define:vars={{ REPO }}>
    document.getElementById('submit-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const type = fd.get('type');
      const title = `[${type}] ${fd.get('name')}`;
      const body = [
        '## Submission',
        '',
        `- **Type:** ${type}`,
        `- **Name:** ${fd.get('name')}`,
        `- **Summary:** ${fd.get('summary')}`,
        `- **License:** ${fd.get('license')}`,
        `- **Maintainers:** ${fd.get('maintainers')}`,
        `- **Artifact URL:** ${fd.get('artifact_url') || '—'}`,
        `- **SHA-256:** ${fd.get('sha256') || '—'}`,
        `- **Domains:** ${fd.get('domains') || '—'}`,
        '',
        '## Notes',
        '',
        String(fd.get('notes') || '—'),
        '',
        '---',
        '*Submitted via unite4ai.com/submit — a maintainer will scaffold the PR.*',
      ].join('\n');
      const url = `${REPO}/issues/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  </script>
</Base>
