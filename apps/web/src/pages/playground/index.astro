---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { INFERENCE_PROTOCOLS } from '@unite4ai/core';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';

const models = await getCollection('models');
const coursePath = '/school/run-open-weights';
const entries = models.map(({ id, data }) => {
  const guide = data.inference?.run_local_guide;
  return {
    id,
    name: data.name,
    setupUrl: guide && guide.replace(/\/$/, '') !== coursePath
      ? (guide.startsWith('/') ? href(guide) : guide)
      : undefined,
    endpoint: data.inference?.endpoint_url,
    protocol: data.inference?.protocol,
    demos: data.artifacts.filter((artifact) => artifact.kind === 'demo'),
  };
});
---
<Base
  title="Playground"
  description="Find model setup guides, external demos, and inference endpoints. Unite4AI does not proxy inference."
>
  <section class="wrap section">
    <p class="eyebrow">Playground</p>
    <h1>Open model experiences</h1>
    <p class="lede">
      Check what's available for each model before choosing how to try it.
      Unite4AI does not proxy inference. Check the provider's data and logging policies before sending anything to an external demo or endpoint.
    </p>
    <div class="hero-actions">
      <a class="btn btn-ghost" href={href(coursePath)}>Learn to run open weights locally</a>
      <a class="btn btn-ghost" href={href('/evals')}>Experiments</a>
    </div>

    {entries.length === 0 ? (
      <div class="empty" style="margin-top:2rem">
        No playground entries yet. <a href={href('/contribute')}>Submit a model with a demo or inference URL.</a>
      </div>
    ) : (
      <div class="grid grid-2" style="margin-top:2rem">
        {entries.map((entry) => (
          <article class="card">
            <h2>{entry.name}</h2>
            {entry.setupUrl ? (
              <p><a href={entry.setupUrl}>Model-specific setup guide</a></p>
            ) : (
              <p>Model-specific setup guide not available here.</p>
            )}
            {entry.endpoint && (
              <p><a href={entry.endpoint}>
                {entry.protocol ? `${INFERENCE_PROTOCOLS[entry.protocol]} endpoint` : 'Inference endpoint'}
              </a></p>
            )}
            {entry.demos.map((demo) => (
              <p><a href={demo.url}>External demo or code</a></p>
            ))}
            <p style="margin-top:.75rem">
              <a class="btn btn-ghost" href={href(`/registry/models/${entry.id}`)}>Model card</a>
            </p>
          </article>
        ))}
      </div>
    )}

    <p style="margin-top:2.5rem">
      <a href={href('/stack/compute')}>Browse compute options</a>
    </p>
  </section>
</Base>
