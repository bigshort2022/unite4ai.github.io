---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { opennessScore } from '@unite4ai/core';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';

const models = (await getCollection('models')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const registryIndex = models.map((m) => ({
  id: m.id,
  openness_score: opennessScore(m.data.openness),
}));
---
<Base title="Model registry">
  <section class="wrap section">
    <p class="eyebrow">Registry</p>
    <h1>Open models</h1>
    <p class="lede">
      Every entry is graded on four Model Openness Framework axes and carries a verifiable artifact
      checksum. Restrictive licenses cannot be merged — CI blocks them.
    </p>
    <p style="margin-top:1rem">
      <a class="btn btn-ghost" href={href('/registry/datasets')}>Datasets →</a>
      <a class="btn btn-ghost" href={href('/contribute')}>Submit a model</a>
    </p>

    <div class="registry-controls" style="margin-top:1.5rem">
      <label>
        <span class="sr-only">Filter by domain</span>
        <select data-registry-filter="domain">
          <option value="">All domains</option>
          {[...new Set(models.flatMap((m) => m.data.domains))].map((d) => (
            <option value={d}>{d}</option>
          ))}
        </select>
      </label>
      <label>
        <span class="sr-only">Sort by</span>
        <select data-registry-sort>
          <option value="updated">Recently updated</option>
          <option value="openness">Openness score</option>
          <option value="name">Name</option>
        </select>
      </label>
      <label>
        <span class="sr-only">Minimum openness</span>
        <input type="range" data-registry-min-openness min="0" max="100" value="0" step="5" />
        <span data-registry-min-label>Any openness</span>
      </label>
    </div>

    {models.length === 0 ? (
      <div class="empty" style="margin-top:2rem">No models yet. <a href={href('/contribute')}>Add the first one.</a></div>
    ) : (
      <div class="grid grid-3" style="margin-top:2rem" data-registry-grid>
        {models.map((m) => {
          const score = registryIndex.find((r) => r.id === m.id)?.openness_score ?? 0;
          return (
            <article
              class="card registry-card"
              data-domain={m.data.domains.join(',')}
              data-openness={score}
              data-name={m.data.name.toLowerCase()}
              data-updated={m.data.updated.valueOf()}
            >
              <h3><a href={href(`/registry/models/${m.id}`)}>{m.data.name}</a></h3>
              <p>{m.data.summary}</p>
              <div class="meter" style="margin-top:.6rem"><i style={`width:${score}%`}></i></div>
              <div class="card-meta">
                <span class="tag tag-open">{score}% open</span>
                <span class="tag">{m.data.license}</span>
                {m.data.community_led && <span class="tag tag-open">community-led</span>}
                {m.data.featured && <span class="tag tag-open">featured</span>}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>

  <script is:inline define:vars={{ registryIndex }}>
    const grid = document.querySelector('[data-registry-grid]');
    if (grid) {
      const cards = [...grid.querySelectorAll('.registry-card')];
      const domainFilter = document.querySelector('[data-registry-filter="domain"]');
      const sortSelect = document.querySelector('[data-registry-sort]');
      const minOpenness = document.querySelector('[data-registry-min-openness]');
      const minLabel = document.querySelector('[data-registry-min-label]');

      function applyFilters() {
        const domain = domainFilter?.value ?? '';
        const min = Number(minOpenness?.value ?? 0);
        if (minLabel) minLabel.textContent = min > 0 ? `≥ ${min}% open` : 'Any openness';
        cards.forEach((card) => {
          const domains = card.dataset.domain?.split(',') ?? [];
          const openness = Number(card.dataset.openness ?? 0);
          card.hidden = (domain && !domains.includes(domain)) || openness < min;
        });
        const sort = sortSelect?.value ?? 'updated';
        const visible = cards.filter((c) => !c.hidden);
        visible.sort((a, b) => {
          if (sort === 'openness') return Number(b.dataset.openness) - Number(a.dataset.openness);
          if (sort === 'name') return a.dataset.name.localeCompare(b.dataset.name);
          return Number(b.dataset.updated) - Number(a.dataset.updated);
        });
        visible.forEach((card) => grid.appendChild(card));
      }

      domainFilter?.addEventListener('change', applyFilters);
      sortSelect?.addEventListener('change', applyFilters);
      minOpenness?.addEventListener('input', applyFilters);
    }
  </script>
</Base>
