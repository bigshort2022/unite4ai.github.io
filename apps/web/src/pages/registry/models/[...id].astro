---
import Base from '../../../layouts/Base.astro';
import OpennessMeter from '../../../components/OpennessMeter.astro';
import StackVerifyPanel from '../../../components/StackVerifyPanel.astro';
import { getCollection, render } from 'astro:content';
import { byCodeUnit, localSetups, opennessScore, reproductionLabel } from '@unite4ai/core';
import { REPO, formatNumber, loadEvals, runtimeLabel, scoreRange, withUnit } from '../../../lib/evals';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((m) => ({ params: { id: m.id }, props: { entry: m } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const score = opennessScore(d.openness);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const localGuide = d.inference?.run_local_guide?.startsWith('/')
  ? href(d.inference.run_local_guide)
  : d.inference?.run_local_guide;
const evalData = await loadEvals();
const benchmarkById = new Map(evalData.benchmarks.map((b) => [b.id, b]));
const ownGroups = evalData.groups.filter((g) => g.model === entry.id);
const modelGroups = ownGroups
  .filter((g) => benchmarkById.get(g.benchmark)?.data.version === g.benchmark_version)
  .sort((a, b) => byCodeUnit(a.benchmark, b.benchmark) || byCodeUnit(a.key, b.key));
// Benchmarks this model has results for only in versions before the current one: the table has
// no row for them, and their runs are listed on the benchmark's page.
const inTable = new Set(modelGroups.map((g) => g.benchmark));
const earlier = [...new Set(ownGroups.map((g) => g.benchmark))]
  .filter((id) => !inTable.has(id))
  .sort(byCodeUnit)
  .map((id) => ({
    id,
    name: benchmarkById.get(id)!.data.name,
    versions: [...new Set(ownGroups.filter((g) => g.benchmark === id).map((g) => g.benchmark_version))].sort(byCodeUnit),
  }));
const setups = localSetups(
  evalData.runs.filter((run) => run.model === entry.id),
  new Map(evalData.benchmarks.map((b) => [b.id, b.data.version])),
);
---
<Base title={d.name} description={d.summary}>
  <article class="wrap section" data-pagefind-body data-pagefind-meta={`openness:${score}`} data-pagefind-filter={`license:${d.license}`}>
    <p class="eyebrow"><a href={href('/registry')}>Registry</a> · <a href={href('/stack')}>Open stack</a> · Model</p>
    <h1>{d.name}</h1>
    <p class="lede">{d.summary}</p>

    <div class="card-meta" style="margin:1.2rem 0 2rem">
      <span class="tag tag-open">{d.license}</span>
      {d.tasks.map((t) => <span class="tag">{t}</span>)}
      {d.domains.map((x) => <span class="tag">{x}</span>)}
      {d.sdg_alignment.map((s) => <span class="tag">SDG {s}</span>)}
      {d.community_led && <span class="tag tag-open">community-led</span>}
    </div>

    <div class="grid grid-2" style="margin-bottom:2.5rem">
      <div class="card">
        <OpennessMeter openness={d.openness} />
      </div>
      <StackVerifyPanel
        artifacts={d.artifacts}
        inference={d.inference ? { ...d.inference, run_local_guide: localGuide } : undefined}
        evalBundle={d.eval_bundle}
        modelName={d.name}
      />
    </div>

    <div class="prose"><Content /></div>

    <section style="margin-top:3rem" data-pagefind-ignore>
      <h2>Evaluations</h2>
      {modelGroups.length === 0 ? (
        <p style="color:var(--u-text-dim)">
          {earlier.length === 0 ? 'No evaluation results yet.' : 'No results for the current benchmark versions yet.'} <a href={href('/evals')}>See the benchmarks and how results are submitted.</a>
        </p>
      ) : (
        <div class="eval-scroll" tabindex="0" role="region" aria-label={`Evaluation results for ${d.name}`}>
          <table class="eval-table">
            <caption class="sr-only">Evaluation results for {d.name}</caption>
            <thead>
              <tr><th scope="col">Benchmark</th><th scope="col">Score</th><th scope="col">Setup</th><th scope="col">Speed</th><th scope="col">Runs</th></tr>
            </thead>
            <tbody>
              {modelGroups.map((group) => {
                const benchmark = benchmarkById.get(group.benchmark)!;
                return (
                  <tr>
                    <td><a href={href(`/evals/${group.benchmark}`)}>{benchmark.data.name}</a></td>
                    <td class="num">
                      <span class="score">{withUnit(formatNumber(group.score), benchmark.data.metric.unit)}</span>
                      {scoreRange(group) && <small>range {scoreRange(group)}</small>}
                    </td>
                    <td>
                      {group.format} · {group.quantization}
                      <small>{runtimeLabel(group)}</small>
                      {group.device !== null && <small>{group.device} · {group.memory_gb} GB</small>}
                    </td>
                    <td class="num">{benchmark.data.scoring === 'measured' || group.tokens_per_second === null ? '—' : `${formatNumber(group.tokens_per_second)} tok/s`}</td>
                    <td><span class={`tag${group.submitters.length > 1 ? ' tag-open' : ''}`}>{reproductionLabel(group)}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      {earlier.length > 0 && (
        <p style="margin-top:1rem;color:var(--u-text-dim)">
          Results for earlier versions: {earlier.map((benchmark, index) => (
            <>{index > 0 && ', '}<a href={href(`/evals/${benchmark.id}`)}>{benchmark.name}</a> ({benchmark.versions.map((version) => `v${version}`).join(', ')})</>
          ))}
        </p>
      )}

      {setups.length > 0 && (
        <>
          <h3 style="margin-top:2rem">Runs locally on</h3>
          <p style="color:var(--u-text-dim)">Best measured speed and lowest time to first token per setup, across runs of current benchmark versions; the two can come from different runs and different benchmarks.</p>
          <div class="eval-scroll" tabindex="0" role="region" aria-label={`Setups ${d.name} has been run on`}>
            <table class="eval-table">
              <caption class="sr-only">Setups {d.name} has been run on</caption>
              <thead>
                <tr><th scope="col">Runtime</th><th scope="col">Format</th><th scope="col">Hardware</th><th scope="col">Speed</th><th scope="col">First token</th></tr>
              </thead>
              <tbody>
                {setups.map((s) => (
                  <tr>
                    <td>{s.runtime}</td>
                    <td>{s.format} · {s.quantization}</td>
                    <td>{s.device}<small>{s.accelerator} · {s.memory_gb} GB</small></td>
                    <td class="num">{s.tokens_per_second === null ? '—' : `${formatNumber(s.tokens_per_second)} tok/s`}</td>
                    <td class="num">{s.time_to_first_token_ms === null ? '—' : `${formatNumber(s.time_to_first_token_ms)} ms`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </section>

    <p style="margin-top:3rem;font-size:.88rem;color:var(--u-text-faint)">
      Maintained by {d.maintainers.join(', ')} · Updated {d.updated.toISOString().slice(0, 10)} ·
      <a href={`${REPO}/edit/main/apps/web/src/content/models/${entry.id}.md`}>Suggest an edit</a>
    </p>
  </article>
</Base>
