---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';

const compute = (await getCollection('compute')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);

const PROTOCOL_LABEL: Record<string, string> = {
  'self-hosted': 'Self-hosted',
  'community-gpu': 'Community GPU',
  federated: 'Federated learning',
  'inference-server': 'Inference server',
  'cloud-open': 'Open cloud',
};
---

<Base title="Open compute catalog" description="Curated open and decentralized compute options — indexed, not brokered.">
  <section class="wrap section">
    <p class="eyebrow"><a href={href('/stack')}>Open stack</a> · Compute</p>
    <h1>Open compute options</h1>
    <p class="lede">
      Training and inference without a single gatekeeper. Unite4AI indexes protocols and projects —
      we do not route your jobs or take a cut.
    </p>
    <p style="margin-top:1rem"><a class="btn btn-ghost" href={href('/school/choose-open-compute')}>Course: Choose open compute</a></p>

    {compute.length === 0 ? (
      <div class="empty" style="margin-top:2rem">No compute entries yet.</div>
    ) : (
      <div class="grid grid-3" style="margin-top:2rem">
        {compute.map((c) => (
          <article class="card">
            <h3><a href={href(`/stack/compute/${c.id}`)}>{c.data.name}</a></h3>
            <p>{c.data.summary}</p>
            <div class="card-meta">
              <span class="tag tag-open">{PROTOCOL_LABEL[c.data.protocol] ?? c.data.protocol}</span>
              <span class="tag">{c.data.pricing_model}</span>
              <span class="tag">{c.data.coverage}</span>
              {c.data.last_verified && (
                <span class="tag">verified {c.data.last_verified.toISOString().slice(0, 10)}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
