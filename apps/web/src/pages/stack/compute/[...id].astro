---
import Base from '../../../layouts/Base.astro';
import ComputeBadges from '../../../components/ComputeBadges.astro';
import { getCollection, render } from 'astro:content';
import { REPO } from '../../../lib/site';

export async function getStaticPaths() {
  const items = await getCollection('compute');
  return items.map((x) => ({ params: { id: x.id }, props: { entry: x } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
---
<Base title={d.name} description={d.summary}>
  <article class="wrap section" data-pagefind-body>
    <p class="eyebrow"><a href={href('/stack')}>Open stack</a> · <a href={href('/stack/compute')}>Compute</a></p>
    <h1>{d.name}</h1>
    <p class="lede">{d.summary}</p>

    <div class="card-meta" style="margin:1.2rem 0 2rem">
      <ComputeBadges compute={d} verificationLabel="last verified" />
    </div>

    <div class="card" style="margin-bottom:2rem">
      <p class="eyebrow" style="margin-bottom:.5rem">Open source</p>
      <p><a href={d.open_source_url}>{d.open_source_url}</a></p>
    </div>

    <div class="prose"><Content /></div>

    <p style="margin-top:3rem;font-size:.88rem;color:var(--u-text-faint)">
      Maintained by {d.maintainers.join(', ')} · Updated {d.updated.toISOString().slice(0, 10)} ·
      <a href={`${REPO}/edit/main/apps/web/src/content/compute/${entry.id}.md`}>Suggest an edit</a>
    </p>
  </article>
</Base>
