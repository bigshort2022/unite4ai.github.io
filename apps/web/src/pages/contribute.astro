---
import Base from '../layouts/Base.astro';
import { REPO } from '../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
---
<Base title="Contribute">
  <section class="wrap section">
    <p class="eyebrow">Contribute</p>
    <h1>Contribution <span class="grad-text">is</span> membership</h1>
    <p class="lede">
      There is no signup form. The moment your first pull request merges, you're a member —
      your name appears on the contributors page and you can vote in community polls.
      You can read public issues and prepare a draft without an account. Posting or opening a pull request requires a GitHub account.
    </p>
    <p>
      <a href={`${REPO}/issues`}>Read public issues</a> ·
      <a href={`${REPO}/issues/new/choose`}>Sign in on GitHub to post a public issue</a>
      <span>— include only information you want to share publicly.</span>
    </p>

    <div class="grid grid-3" style="margin-top:2.5rem">
      <article class="card">
        <h3>1. Draft in your browser</h3>
        <p>No git, terminal, or account to prepare a draft. Review and copy it locally. If you choose to post it publicly on GitHub, a maintainer can review it for inclusion.</p>
        <p style="margin-top:auto">
          <a class="btn btn-primary" href={href('/submit')}>Prepare a local draft</a>
        </p>
      </article>
      <article class="card">
        <h3>2. Edit in the browser</h3>
        <p>Use the “Suggest an edit” link on a model card to open GitHub’s web editor. Sign in, make your change, and open a public pull request for review.</p>
      </article>
      <article class="card">
        <h3>3. Clone and PR</h3>
        <p>Fork, branch, and add a card or course under <code>apps/web/src/content/</code>. Run <code>bun run validate</code> and <code>bun run build</code>, then open a public pull request on GitHub.</p>
        <p style="margin-top:auto"><a class="btn btn-ghost" href={REPO}>View the repo</a></p>
      </article>
    </div>

    <h2 style="margin-top:3.5rem">How pull requests are checked</h2>
    <div class="card" style="margin-top:1.2rem">
      <ol style="margin:0;padding-left:1.3rem;line-height:2">
        <li><strong>Schema validation</strong> — CI checks required fields, dates, and structure.</li>
        <li><strong>Listed license</strong> — CI checks the registry’s SPDX allowlist; this does not verify the license of each linked file.</li>
        <li><strong>Artifact bytes</strong> — when a checksum is listed, CI can attempt to check it. This step is advisory; a passing pull request does not establish that every download was verified.</li>
        <li><strong>Site build</strong> — CI checks that the site builds with the change.</li>
        <li><strong>Human review</strong> — maintainers review proposed changes. The <a href={href('/governance/metrics')}>metrics page</a> reports time to merge, not time to first review.</li>
        <li><strong>After merge</strong> — the project’s deployment workflow publishes the site.</li>
      </ol>
    </div>

    <h2 style="margin-top:3rem">What we're looking for right now</h2>
    <div class="grid grid-2" style="margin-top:1.2rem">
      <article class="card">
        <h3>Genuinely open models</h3>
        <p>Link the upstream license and any available weights, and document what is known about training and evaluation. Flag gaps rather than guessing.</p>
      </article>
      <article class="card">
        <h3>Ethically sourced datasets</h3>
        <p>You'll need to state collection method, consent basis, PII review status, and known bias. These are required fields — the schema refuses cards without them.</p>
      </article>
      <article class="card">
        <h3>Courses in any language</h3>
        <p>Especially non-English. AI education that only exists in English is not equitable AI education.</p>
      </article>
      <article class="card">
        <h3>Translations and accessibility fixes</h3>
        <p>Help more people use the site by translating a resource or reporting a specific access barrier.</p>
      </article>
    </div>
  </section>
</Base>
