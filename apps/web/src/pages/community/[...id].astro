---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((e) => ({ params: { id: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const when = d.starts.toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short', timeZone: 'UTC' });
---
<Base title={d.title} description={d.summary}>
  <article class="wrap section" data-pagefind-body>
    <p class="eyebrow"><a href={href('/community')}>Community</a> · {d.kind}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>
    <div class="card-meta" style="margin:1.2rem 0 2rem">
      <span class="tag">{when} UTC</span>
      <span class="tag">{d.location}</span>
    </div>
    {d.register_url && <p><a class="btn btn-primary" href={d.register_url}>Register</a></p>}
    <div class="prose" style="margin-top:2rem"><Content /></div>
  </article>
</Base>
