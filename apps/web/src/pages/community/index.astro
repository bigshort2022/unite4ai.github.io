---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}` || '/';
const now = new Date();
const all = (await getCollection('events')).sort((a, b) => a.data.starts.valueOf() - b.data.starts.valueOf());
const upcoming = all.filter((e) => e.data.starts >= now);
const past = all.filter((e) => e.data.starts < now).reverse();
const posts = (await getCollection('posts')).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<Base title="Community">
  <section class="wrap section">
    <p class="eyebrow">Community</p>
    <h1>Show up. Build. Belong.</h1>
    <p class="lede">
      Workshops, hackathons, and office hours — plus a discussion forum where every thread is
      public and searchable. Membership here is earned by contribution, not by filling in a form.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="https://github.com/unite4ai/unite4ai.github.io/discussions">Join the discussion</a>
      <a class="btn btn-ghost" href={href('/contribute')}>Contribute</a>
    </div>

    <h2 style="margin-top:3rem">Upcoming events</h2>
    {upcoming.length === 0 ? (
      <div class="empty" style="margin-top:1rem">Nothing scheduled yet — propose one in Discussions.</div>
    ) : (
      <div class="grid grid-2" style="margin-top:1.2rem">
        {upcoming.map((e) => (
          <article class="card">
            <h3><a href={href(`/community/${e.id}`)}>{e.data.title}</a></h3>
            <p>{e.data.summary}</p>
            <div class="card-meta">
              <span class="tag">{e.data.starts.toISOString().slice(0, 10)}</span>
              <span class="tag">{e.data.kind}</span>
              <span class="tag">{e.data.location}</span>
            </div>
          </article>
        ))}
      </div>
    )}

    {past.length > 0 && (
      <>
        <h2 style="margin-top:3rem">Past events</h2>
        <div class="grid grid-3" style="margin-top:1.2rem">
          {past.map((e) => (
            <article class="card">
              <h3><a href={href(`/community/${e.id}`)}>{e.data.title}</a></h3>
              <div class="card-meta"><span class="tag">{e.data.starts.toISOString().slice(0, 10)}</span></div>
            </article>
          ))}
        </div>
      </>
    )}

    {posts.length > 0 && (
      <>
        <h2 style="margin-top:3rem">From the blog</h2>
        <div class="grid grid-3" style="margin-top:1.2rem">
          {posts.map((p) => (
            <article class="card">
              <h3><a href={href(`/blog/${p.id}`)}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
              <div class="card-meta"><span class="tag">{p.data.published.toISOString().slice(0, 10)}</span></div>
            </article>
          ))}
        </div>
      </>
    )}
  </section>
</Base>
